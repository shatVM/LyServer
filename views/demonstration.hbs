<div class="page-title-area">
  <h2>🖥️ Спільна демонстрація</h2>
  <p class="hint" id="demoSubtitle">
    Синхронний показ навчальних матеріалів для всієї аудиторії або укриття в режимі реального часу.
  </p>
</div>

<div class="grid-demo" id="demoGridContainer">
  <!-- Shared Display Panel -->
  <section class="panel demo-screen-panel">
    <!-- Issue #75 (доробка за зворотним зв'язком власника): заголовок, статус
         показу та всі елементи керування — в ОДНОМУ рядку навпроти назви
         «Спільний екран». Текстові написи на кнопках замінено іконками
         (назва дії збережена в title/aria-label), статус і номер слайда —
         динамічні тексти, вони лишаються в рядку -->
    <div class="panel-header-row demo-screen-header">
      <h2 id="viewerTitle">Спільний екран</h2>
      <div id="status" class="status">Підключення до спільної трансляції…</div>
      <div class="row demo-header-actions">
        <div id="syncIndicator" class="status-dot status-dot-online"
             title="Синхронізація активна" role="img" aria-label="Синхронізація активна"></div>
        <button id="showShared" type="button" class="secondary btn-sm icon-btn"
                title="Оновити" aria-label="Оновити">
          <svg class="ui-icon" aria-hidden="true"><use href="/icons.svg#refresh-cw"></use></svg>
        </button>
        <!-- Панель показу (лише викладач): попередній/наступний слайд,
             номер і перехід, зупинка демонстрації — усе іконками -->
        <div class="row teacher-only demo-page-controls" id="teacherDemoControls" style="display:none">
          <button id="prevPage" type="button" class="secondary btn-sm icon-btn"
                  title="Попередня сторінка" aria-label="Попередня сторінка">
            <svg class="ui-icon" aria-hidden="true"><use href="/icons.svg#chevron-left"></use></svg>
          </button>
          <span id="pageLabel" class="hint">PDF: сторінка 1</span>
          <button id="nextPage" type="button" class="secondary btn-sm icon-btn"
                  title="Наступна сторінка" aria-label="Наступна сторінка">
            <svg class="ui-icon" aria-hidden="true"><use href="/icons.svg#chevron-right"></use></svg>
          </button>
          <input id="pageInput" class="page-input" type="number" min="1" step="1" inputmode="numeric" placeholder="№" aria-label="Номер сторінки">
          <button id="gotoPage" type="button" class="secondary btn-sm icon-btn"
                  title="Перейти до сторінки" aria-label="Перейти до сторінки">
            <svg class="ui-icon" aria-hidden="true"><use href="/icons.svg#corner-down-left"></use></svg>
          </button>
          <button id="stopDemo" type="button" class="secondary btn-sm icon-btn"
                  title="Зупинити демонстрацію" aria-label="Зупинити демонстрацію">
            <svg class="ui-icon" aria-hidden="true"><use href="/icons.svg#square"></use></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Live Viewer for everyone -->
    <div id="viewer">
      <div class="empty">Очікування початку демонстрації від викладача…</div>
    </div>
  </section>

  <!-- Issue #19: блок «Учні» у правій колонці сітки -->
  {{> studentsBlock}}
</div>

<!-- Issue #63, Етап 2: блок «Додати матеріали» — наявний механізм завантаження,
     під'єднаний до сторінки «Демонстрація». Розташований після блоку «Учні» і
     перед панеллю показу. Статус завантаження (#uploadStatus) окремий від
     статусу спільного екрана (#status), який оновлює опитування демонстрації. -->
<section class="panel demo-upload-panel teacher-only" id="teacherUploadPanel" style="display:none">
  <div class="panel-header-row">
    <h3>Додати матеріали</h3>
  </div>
  <div class="upload-box">
    <label for="uploadFile"><strong>Виберіть файли на пристрої:</strong></label>
    <div class="upload-category-row">
      <label for="uploadCategory">Категорія для завантажених матеріалів:</label>
      <select id="uploadCategory"><option value="">Без категорії</option></select>
      <button id="createCategoryFromUpload" type="button" class="secondary btn-sm"><svg class="ui-icon" aria-hidden="true"><use href="/icons.svg#plus"></use></svg> Створити категорію</button>
    </div>
    <div style="margin-top:8px">
      <input id="uploadFile" type="file" multiple accept=".pdf,.ppt,.pptx,.mp4,.webm,.m4v,.mov,.ogg,.mp3,.wav">
    </div>
    <!-- Issue #63, Етап 3: черга вибраних файлів — для кожного можна задати
         власний необов'язковий опис (порожній опис = файл без опису) -->
    <div id="uploadQueue" class="upload-queue"></div>
    <button id="upload" style="margin-top:14px; width:100%">
      🚀 Завантажити на сервер
    </button>
  </div>
  <div id="uploadStatus" class="status">Оберіть один або кілька файлів для завантаження.</div>
  <p class="hint">
    PDF, PPT та PPTX після завантаження автоматично конвертуються у PNG-слайди; підтримуються файли розміром до 1 ГБ.
    Опис є необов'язковим — його можна залишити порожнім.
  </p>
</section>

<!-- Issue #63, Етап 2: панель показу матеріалів (заголовок оновлено цим етапом).
     Етап 4 (§3): єдина панель керування вчителя — приватний перегляд, спільна
     демонстрація, видимість, перейменування, категорії та порядок -->
<section class="panel demo-controls-panel teacher-only" id="teacherBroadcastPanel" style="display:none">
  <div class="panel-header-row">
    <h3>Матеріали</h3>
    <div class="row">
      <!-- Issue #63 (доробка): дві окремі кнопки «Згорнути всі» / «Розгорнути всі» -->
      <button id="collapseAllCategoriesBtn" type="button" class="secondary btn-sm" title="Згорнути всі категорії" aria-label="Згорнути всі категорії">
        <svg class="ui-icon" aria-hidden="true"><use href="/icons.svg#arrow-up"></use></svg>
        <span class="btn-text">Згорнути всі</span>
      </button>
      <button id="expandAllCategoriesBtn" type="button" class="secondary btn-sm" title="Розгорнути всі категорії" aria-label="Розгорнути всі категорії">
        <svg class="ui-icon" aria-hidden="true"><use href="/icons.svg#arrow-down"></use></svg>
        <span class="btn-text">Розгорнути всі</span>
      </button>
      <button id="createCategoryBtn" type="button" class="secondary btn-sm" title="Створити нову категорію">
        <svg class="ui-icon" aria-hidden="true"><use href="/icons.svg#plus"></use></svg> Створити категорію
      </button>
      <button id="refresh" class="secondary btn-sm">🔄 Оновити</button>
    </div>
  </div>
  <p class="hint">Оберіть матеріал (включно з прихованими від учнів): 👁️ приватний перегляд або 📺 спільна демонстрація. Тут само — видимість, категорії та порядок:</p>
  <div id="files" class="files-list">
    <div class="empty">Завантаження списку…</div>
  </div>
</section>

<!-- Issue #63 (§3.3): приватний перегляд викладача в модальному вікні.
     Відкривається дією «👁️ Перегляд», закривається кнопкою ✕ або Escape;
     не змінює стан спільної демонстрації -->
<div id="previewModal" class="modal-backdrop preview-backdrop" style="display:none">
  <div class="modal-card preview-modal-card" role="dialog" aria-modal="true" aria-labelledby="previewModalTitle">
    <div class="preview-modal-header">
      <h3 id="previewModalTitle">Приватний перегляд</h3>
      <button type="button" id="previewClose" class="secondary btn-sm preview-close"
              aria-label="Закрити приватний перегляд" title="Закрити (Esc)">✕</button>
    </div>
    <div class="row preview-controls" id="previewControls" style="display:none">
      <button type="button" id="previewPrev" class="secondary btn-sm">← Попередня</button>
      <span class="hint" id="previewPageLabel">Сторінка 1</span>
      <button type="button" id="previewNext" class="secondary btn-sm">Наступна →</button>
      <input id="previewPageInput" class="page-input" type="number" min="1" step="1" inputmode="numeric" placeholder="№" aria-label="Номер сторінки">
      <button type="button" id="previewGoto" class="secondary btn-sm">Перейти</button>
    </div>
    <div id="previewViewer" class="preview-viewer">
      <div class="empty">Завантаження…</div>
    </div>
    <p class="hint preview-hint">Приватний перегляд: це вікно бачите лише ви — спільну демонстрацію воно не змінює.</p>
  </div>
</div>
