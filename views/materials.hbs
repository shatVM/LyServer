<div class="page-title-area">
  <h2>📖 Перегляд матеріалів</h2>
  <p class="hint" id="materialsSubtitle">
    Оберіть матеріал для індивідуального вивчення. Особистий перегляд не впливає на показ інших учасників.
  </p>
</div>

<div class="grid-2col">
  <!-- Issue #63: контейнер каталогу ховається на час спільної демонстрації
       (два режими однієї сторінки учня — див. setMaterialsDemoMode у app.js) -->
  <section class="panel" id="materialsCatalogPanel">
    <div class="panel-header-row">
      <h2 id="catalogTitle">Каталог матеріалів</h2>
      <button id="refresh" class="secondary btn-sm">🔄 Оновити</button>
    </div>
    <div id="status" class="status">Завантаження каталогу матеріалів…</div>
    <div id="files" class="files-list">
      <div class="empty">Завантаження списку…</div>
    </div>
  </section>

  <section class="panel">
    <div class="panel-header-row">
      <h2 id="viewerTitle">Особистий перегляд</h2>
      <div id="pdfControls" class="row pdf-controls" style="display:none">
        <button id="prevPage" class="secondary btn-sm">← Попередня</button>
        <span id="pageLabel" class="hint">Сторінка 1</span>
        <button id="nextPage" class="secondary btn-sm">Наступна →</button>
        <input id="pageInput" class="page-input" type="number" min="1" step="1" inputmode="numeric" placeholder="№">
        <button id="gotoPage" class="secondary btn-sm">Перейти</button>
      </div>
    </div>
    <div id="viewer">
      <div class="empty">Оберіть файл зі списку та натисніть «Відкрити для себе».</div>
    </div>
    <div class="hint" style="margin-top:12px">
      💡 Особистий перегляд дозволяє читати PDF чи переглядати відео у власному темпі.
    </div>
  </section>
</div>

<!-- Issue #19: список учнів окремим блоком (нижче основного вмісту) -->
{{> studentsBlock}}
