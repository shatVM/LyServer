<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#153e75">
  <title>{{title}} — Навчальний простір</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  {{> header}}
  {{> nav}}

  <main class="main-container">
    {{{body}}}
  </main>

  {{> footer}}

  <!-- Toast container (teacher disconnect notifications) -->
  <div id="toastContainer" class="toast-container"></div>

  <!-- Issue #79: оверлей візуального сигналу учневі — рамка зі світінням по
       периметру доступної області перегляду та напис по центру поверх
       матеріалу (pointer-events:none, тому керування показом не перекривається).
       Прихований, поки сервер не надішле активний сигнал; параметри (колір,
       прозорість) задаються змінними при показу -->
  <div id="signalOverlay" class="signal-overlay" style="display:none" role="status" aria-live="polite">
    <div class="signal-overlay-frame" aria-hidden="true"></div>
    <div class="signal-overlay-text"></div>
  </div>

  <!-- Issue #75: системний повноекранний режим спільної демонстрації на
       пристрої учня. Браузер вмикає Fullscreen API лише за прямого жесту
       користувача, тому кнопка, а не віддалений запуск; прихована, поки на
       цій сторінці не активний розгорнутий режим показу (body.demo-focus) -->
  <button type="button" id="demoFullscreenBtn" class="secondary demo-fs-btn"
          style="display:none"
          title="Системний повноекранний режим (вихід — Esc)">⛶ На весь екран</button>

  <!-- Role Selection Modal -->
  <div id="roleModal" class="modal-backdrop" style="display:none">
    <div class="modal-card">
      <div class="modal-header">
        <h2>Оберіть режим доступу</h2>
        <p class="hint">Оберіть роль для налаштування зручного інтерфейсу</p>
      </div>
      <div class="role-grid">
        <!-- Student Option -->
        <div class="role-option-card student-card">
          <div class="role-icon">👤</div>
          <h3>Я учень</h3>
          <p>Простий і чистий інтерфейс: перегляд дозволених матеріалів та участь у спільній демонстрації уроку.</p>
          <div class="student-name-box">
            <input id="modalStudentName" type="text" placeholder="Прізвище та ім'я (напр. Коваленко Олена)" autocomplete="off" maxlength="60">
            <div id="modalStudentError" class="modal-error" style="display:none"></div>
            <button id="btnChooseStudent" class="btn-student">Увійти як учень</button>
          </div>
        </div>
        
        <!-- Teacher Option -->
        <div class="role-option-card teacher-card">
          <div class="role-icon">🎓</div>
          <h3>Я викладач</h3>
          <p>Повний доступ: керування трансляцією, завантаження, приховування та видалення матеріалів.</p>
          <div class="teacher-login-box">
            <input id="modalTeacherPin" type="password" placeholder="Введіть PIN викладача" autocomplete="off">
            <button id="btnChooseTeacher" class="btn-teacher">Увійти як викладач</button>
            <div id="modalPinError" class="modal-error" style="display:none"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
